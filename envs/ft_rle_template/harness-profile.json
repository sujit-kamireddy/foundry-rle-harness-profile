  "episodeCompletion": {
    "mode": "open_ended_tool",
    "stopCondition": {
      "type": "done"
    },
    "successCondition": {
      "type": "reward_at_least",
      "rewardThreshold": 0.5
    },
    "maxStepsBehavior": "truncate"
  },
  "reward": {
    "aggregation": "final",
    "successCondition": "reward_at_least",
    "successRewardThreshold": 0.5
  },
  "limits": {
    "maxStepsPerEpisode": 12,
    "timeoutSeconds": 180
  },
  "evalDefaults": {
    "split": "validation",
    "rolloutsPerCase": 1,
    "limit": 4
  },
  "trainingDefaults": {
    "split": "train",
    "rolloutsPerCase": 8
  },
  "notes": "Rendered from FT world world-hr-onboarding at content version 2026-07-31.1."
