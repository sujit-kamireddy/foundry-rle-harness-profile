            "arguments": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "description": "Optional filter, for example badge or security."
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "tool_name",
            "arguments"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "get_employee_record",
        "description": "Fetch one employee record by employee id.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string",
              "const": "get_employee_record"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "employee_id": {
                  "type": "string",
                  "description": "Employee id, for example e-1043."
                }
              },
              "required": [
                "employee_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tool_name",
            "arguments"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_case_notes",
