      {
        "actionName": "list_pending_onboarding_tasks",
        "toolName": "list_pending_onboarding_tasks",
        "toolDescription": "List outstanding onboarding checklist items, optionally filtered by category."
      },
      {
        "actionName": "get_employee_record",
        "toolName": "get_employee_record",
        "toolDescription": "Fetch one employee record by employee id."
      },
      {
        "actionName": "list_case_notes",
        "toolName": "list_case_notes",
        "toolDescription": "List case notes recorded against an employee."
      },
      {
        "actionName": "create_case_note",
        "toolName": "create_case_note",
        "toolDescription": "Record a follow-up case note against an employee."
      },
      {
        "actionName": "submit_answer",
        "toolName": "submit_answer",
        "toolDescription": "Submit the final response to the user. Ends the episode."
      }
    ],
    "terminalActions": [
      "submit_answer"
    ],
    "graderActions": [],
    "ignoredActions": [],
    "actions": [
      {
        "name": "list_pending_onboarding_tasks",
        "description": "List outstanding onboarding checklist items, optionally filtered by category.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string",
              "const": "list_pending_onboarding_tasks"
