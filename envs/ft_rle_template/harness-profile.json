        "inputSchema": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string",
              "const": "list_case_notes"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "employee_id": {
                  "type": "string"
                }
              },
              "required": [
                "employee_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tool_name",
            "arguments"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "create_case_note",
        "description": "Record a follow-up case note against an employee.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string",
              "const": "create_case_note"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "employee_id": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "Follow-up text."
                }
              },
              "required": [
                "employee_id",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tool_name",
            "arguments"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "submit_answer",
        "description": "Submit the final response to the user. Ends the episode.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tool_name": {
              "type": "string",
              "const": "submit_answer"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string",
                  "description": "The final response to the user's request."
                }
              },
              "required": [
                "answer"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tool_name",
            "arguments"
          ],
          "additionalProperties": false
        }
      }
